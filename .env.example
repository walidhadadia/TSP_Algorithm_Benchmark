# Vitesse de simulation (millisecondes entre chaque étape)
SIMULATION_SPEED_MS=400

# Chemin vers la base de données SQLite
DB_PATH=data.db

# Paramètres de l'algorithme génétique
GA_POPULATION_SIZE=50
GA_GENERATIONS=100
GA_MUTATION_RATE=0.02
GA_TOURNAMENT_SIZE=5

# Serveur
HOST=127.0.0.1
PORT=8000
